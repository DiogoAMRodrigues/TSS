# Local middleware (simulated KYC, dev default):
VITE_API_URL=http://localhost:3000

# To test the real eIDAS flow (Cartão de Cidadão via AMA Autenticação.gov),
# point the frontend at the deployed VM middleware. AMA must be able to
# callback to this same host — localhost won't work for real eIDAS.
# VITE_API_URL=https://tss.dpss.inesc-id.pt

# Use an OPERATOR key for full admin access (user lookup, revoke, reconcile).
# Use 'client-key' for the user-facing KYC flow (incl. real eIDAS).
VITE_API_KEY=operator-dev-key

# Set to "true" to see API calls in browser console
VITE_DEBUG=false
