MIDDLEWARE_PORT=8080
RPC_URL=http://localhost:8545
IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
OPERATOR_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY
ATTESTATION_DAYS=90
CHALLENGE_TTL_SECONDS=300
MIDDLEWARE_AUTH_ENABLED=true
# Format: key:ROLE[,ROLE];key2:ROLE
# Roles: CLIENT, OPERATOR, REGULATOR, ADMIN
MIDDLEWARE_API_KEYS=client-dev-key:CLIENT;operator-dev-key:OPERATOR;regulator-dev-key:REGULATOR
MIDDLEWARE_RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_CHALLENGE_MAX=30
RATE_LIMIT_VERIFY_MAX=60
STORE_PERSIST_ENABLED=true
STORE_PERSIST_FILE=middleware/data/store.json
RECONCILE_INTERVAL_MS=0
CORS_ORIGIN=*
ALLOW_DEV_KEYS=false
# Optional: custom ABI path
# IDENTITY_ABI_PATH=artifacts/contracts/identity/Identity.sol/Identity.json
