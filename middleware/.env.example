MIDDLEWARE_PORT=3000
RPC_URL=http://localhost:8545
IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
# Store the operator key in a local ignored file and point to it here.
OPERATOR_PRIVATE_KEY_FILE=middleware/.operator-private-key
ATTESTATION_DAYS=90
CHALLENGE_TTL_SECONDS=300
MIDDLEWARE_AUTH_ENABLED=true
# Format: key:ROLE[,ROLE];key2:ROLE
# Roles: CLIENT, OPERATOR, REGULATOR, ADMIN
MIDDLEWARE_API_KEYS=client-key:CLIENT;operator-key:OPERATOR;regulator-key:REGULATOR
MIDDLEWARE_RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_CHALLENGE_MAX=30
RATE_LIMIT_VERIFY_MAX=60
STORE_PERSIST_ENABLED=true
STORE_PERSIST_FILE=middleware/data/store.json
RECONCILE_INTERVAL_MS=0
CORS_ORIGIN=*
ALLOW_DEV_KEYS=false
# Optional: custom ABI path
# IDENTITY_ABI_PATH=artifacts/contracts/identity/Identity.sol/Identity.json

# ----- eIDAS / Autenticação.gov (AMA) -----
# simulated | real
EIDAS_PROVIDER=simulated
# AMA preprod
EIDAS_IDP_ENTRY_POINT=https://preprod.autenticacao.gov.pt/fa/Default.aspx
EIDAS_IDP_CERT_PATH=middleware/certs/ama-preprod-ca.crt
# Pin once you've observed it in a real response (leave blank to skip check)
# EIDAS_IDP_ISSUER=
# Our SP, as registered with AMA
EIDAS_SP_ENTITY_ID=https://tss.dpss.inesc-id.pt
EIDAS_SP_PROVIDER_NAME=TSS - Instituto Superior Técnico
EIDAS_SP_ACS_URL=https://tss.dpss.inesc-id.pt/api/kyc/eidas/callback
EIDAS_SP_SLO_URL=https://tss.dpss.inesc-id.pt/logout
EIDAS_SP_CERT_PATH=middleware/certs/tss-saml-leaf.crt
EIDAS_SP_KEY_PATH=middleware/certs/tss-saml.key
# AMA short attribute names — see ATTR_URN map in realEidasProvider.js
EIDAS_REQUESTED_ATTRIBUTES=NIC,NomeCompleto,DataNascimento,CorreioElectronico
EIDAS_CLOCK_SKEW_SECONDS=60
